@startuml components
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam componentStyle rectangle
skinparam defaultFontSize 15

actor "User" as user
cloud "OpenSky API" as opensky
cloud "Weather reports\n(METAR)" as weather
cloud "LLM API" as llm
database "Cloudflare R2\n(archives, backups)" as r2

package "Home" {
  component "Collector\n(PC, then Raspberry Pi)" as collector #C8E6C9
  database "Local spool" as spool #C8E6C9
}

package "User's browser" {
  component "Web app\n(React, MapLibre, deck.gl)" as web
}

package "Oracle Cloud VM (Docker Compose)" {
  component "ingest-api\n(FastAPI)" as ingest #C8E6C9
  database "PostgreSQL\nTimescaleDB + PostGIS" as db #C8E6C9
  component "public-api\n(FastAPI)" as api
  component "stream-worker" as stream
  component "Dagster\n(jobs, training)" as dagster
  component "MLflow" as mlflow
  component "Grafana" as grafana
}

opensky --> collector : positions, flight lists
collector --> spool : saves first
collector --> ingest : uploads over Tailscale
collector --> r2 : daily archive
ingest --> db
db --> stream : new snapshots
stream --> db : events, predictions
user --> web
web --> api : REST + live updates
api --> db
api --> llm : chat
grafana --> db
dagster --> db
dagster --> mlflow
dagster --> llm : briefing
dagster --> r2 : backups
weather --> dagster

legend right
  |<#C8E6C9> Running now |
  |<#F1F1F1> Planned |
endlegend
@enduml
