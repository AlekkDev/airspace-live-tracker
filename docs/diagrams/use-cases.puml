@startuml use-cases
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle

actor "User" as user
actor "Team member" as team
actor "Scheduler" as scheduler
actor "OpenSky API" as opensky
actor "LLM API" as llm

rectangle "Airspace Monitor" {
  usecase "Watch live traffic\non the map" as UC1
  usecase "Inspect an aircraft" as UC2
  usecase "See unusual traffic\nand the event feed" as UC3
  usecase "See predicted arrivals" as UC4
  usecase "Read the AI briefing" as UC5
  usecase "Ask a question in\nplain English" as UC6
  usecase "Monitor data health\nand models" as UC7
  usecase "Collect and store\nflight data" as UC8
  usecase "Refresh data, retrain models,\nwrite the AI briefing" as UC9
}

user --> UC1
user --> UC2
user --> UC3
user --> UC4
user --> UC5
user --> UC6
team --> UC7
scheduler --> UC8
scheduler --> UC9
UC8 --> opensky
UC6 --> llm
UC9 --> llm
@enduml
