@startuml seq-chat
skinparam shadowing false
hide footbox
skinparam defaultFontName Arial

actor "User" as U
participant "public-api" as A
participant "LLM API" as C
database "PostgreSQL\n(read-only role)" as D

U -> A : question
A -> A : check usage limits
A -> C : question + list of allowed views
C --> A : proposed SQL
A -> A : check SQL: one SELECT,\nallowed views only
A -> D : run with timeout and row limit
D --> A : rows
A -> C : rows
C --> A : answer
A --> U : answer + the SQL
@enduml
