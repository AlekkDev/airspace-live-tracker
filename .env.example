# Copy to .env (git-ignored) and fill in. Read by libs/airspace_common/settings.py.
# Where each secret lives: docs/01-architecture.md#networking-and-security

# --- Collector (docs/04-pipelines.md#p1--collector) ---
# This collector's id
COLLECTOR_ID=pc-daniel
# OpenSky API client (OAuth2 client credentials) from your OpenSky account page
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Seconds between polls, and this collector's offset on that grid
CADENCE_SECONDS=90
OFFSET_SECONDS=0
# Local spool (pending/, sent/, rejected/, archive/, state/, logs/); relative to the working directory
SPOOL_DIR=spool
# false = spool-only mode (M0, before the server exists)
UPLOAD_ENABLED=false
# Fetch yesterday's /flights/all at 06:00 UTC
FLIGHT_LISTS_ENABLED=true
# Ingest API (M1); unused while UPLOAD_ENABLED=false
INGEST_URL=http://airspace-vm:8000/ingest/v1
INGEST_API_KEY=

# --- Server: infra/.env on the VM (docs/03-data-model.md#roles) ---
# Database role passwords. Generate each with: openssl rand -hex 24
POSTGRES_PASSWORD=
AIRSPACE_OWNER_PASSWORD=
INGEST_WRITER_PASSWORD=
STREAM_WORKER_PASSWORD=
JOBS_PASSWORD=
APP_READER_PASSWORD=
LLM_READONLY_PASSWORD=
GRAFANA_READER_PASSWORD=
DAGSTER_DB_PASSWORD=
MLFLOW_DB_PASSWORD=
